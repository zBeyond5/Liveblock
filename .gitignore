# ============================================================
# SANG HUB — .gitignore
# ============================================================

# ---------- Chaves e tokens (CRÍTICO) ----------
# Nunca commitar. Nada que contenha credencial entra no repo.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore

# Config com tokens (JSON/YAML/TOML)
config/api-keys.json
config/api-keys.*.json
config/keys.json
config/secrets.json
config/credentials.json
config/firebase-config.json
config/service-account.json
config/google-services.json
api-keys.json
secrets.json
credentials.json
service-account.json
google-services.json
firebase-config.json
.google-credentials/

# Chaves em variáveis de ambiente (arquivos locais)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Google Cloud SDK
.gcloud/
.gcloudignore

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
firebase.json
.firebaserc

# ---------- Config específica do usuário ----------
# Qualquer arquivo de config pessoal que não deve subir
*.local.json
*.personal.json
usuario.config.*
local.config.*
meu-*.json

# ---------- Node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.yarn/
.yarn-integrity
package-lock.json.bak
yarn.lock.bak

# ---------- Build / distribuição ----------
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.webpack/
*.tsbuildinfo

# ---------- Logs e temporários ----------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- IDEs e editores ----------
.vscode/
!.vscode/settings.example.json
!.vscode/extensions.json
.idea/
*.iml
*.ipr
*.iws
*.sublime-project
*.sublime-workspace
*.code-workspace
.project
.classpath
.settings/

# ---------- Testes e cobertura ----------
coverage/
.nyc_output/
*.lcov
junit.xml

# ---------- Ambiente ----------
venv/
.venv/
env/
ENV/
*.pyc
__pycache__/

# ---------- Sistema / editores ----------
*.orig
*.rej
*.pid
*.seed
*.tgz
*.tar.gz

# ---------- Backup de arquivos de módulo ----------
modules/*.bak
modules/*.old
modules/*.backup
modules/*.tmp
modules/_dev_*.js
modules/_test_*.js

# ---------- Proxy local (se você subir o Node do Puter/apis aqui) ----------
puter-proxy/node_modules/
puter-proxy/.env
puter-proxy/config.json
puter-proxy/logs/

# ---------- Misc ----------
.history/
.eslintcache
.stylelintcache
